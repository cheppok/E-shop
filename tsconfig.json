{
  "compilerOptions": {
    /* Language / Environment */
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",

    /* Type Checking */
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* Module Resolution */
    "module": "esnext",
    "moduleResolution": "bundler",

    /* Build */
    "noEmit": true,
    "incremental": true,

    /* Paths (for @/* imports) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    /* Next.js plugin */
    "plugins": [{ "name": "next" }],

    /* Allow JS files (optional) */
    "allowJs": true,

    /* Pick up custom global type definitions */
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "lib/**/*",
    "types/**/*.d.ts",    // 👈 include your custom NextAuth types
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
